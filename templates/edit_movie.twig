{% extends 'base.twig' %}
{% block title %}Edit: {{ movie.title }} – {{ site_name }}{% endblock %}
{% block content %}

<div class="breadcrumb"><a href="index.php">Home</a> › <a href="movie_details.php?id={{ movie.movie_id }}">{{ movie.title }}</a> › Edit</div>

<div class="page-header">
    <h1>✏️ Edit Movie</h1>
    <a href="index.php" class="btn btn-secondary">← Back to Collection</a>
</div>

{% if errors %}
<div class="errors">
    <strong>Please fix the following:</strong>
    <ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
</div>
{% endif %}

<div class="card">
    <form method="POST" action="edit_movie.php?id={{ movie.movie_id }}">

        <h3 style="margin-bottom:1.2rem; color:var(--accent); border-bottom:1px solid var(--border); padding-bottom:.6rem;">📋 Basic Information</h3>
        <div class="form-grid">
            <div class="form-group form-full">
                <label>Movie Title <span style="color:var(--accent);">*</span></label>
                <input type="text" name="title" required value="{{ movie.title }}" maxlength="255">
            </div>

            <div class="form-group">
                <label>Genre</label>
                <input type="text" name="genre" list="genre-list" value="{{ movie.genre }}" placeholder="e.g. Action, Drama">
                <datalist id="genre-list">
                    {% for g in existing_genres %}
                    <option value="{{ g.genre }}">
                    {% endfor %}
                </datalist>
            </div>

            <div class="form-group">
                <label>Director</label>
                <input type="text" name="director" value="{{ movie.director }}" placeholder="e.g. Christopher Nolan" maxlength="255">
            </div>

            <div class="form-group form-full">
                <label>Cast Members</label>
                <input type="text" name="cast_members" value="{{ movie.cast_members }}" placeholder="e.g. Christian Bale, Heath Ledger" maxlength="500">
            </div>

            <div class="form-group">
                <label>Release Year</label>
                <input type="number" name="release_year" min="1888" max="2030" value="{{ movie.release_year }}">
            </div>

            <div class="form-group">
                <label>Duration (minutes)</label>
                <input type="number" name="duration_minutes" min="1" max="999" value="{{ movie.duration_minutes }}">
            </div>

            <div class="form-group">
                <label>Language</label>
                <input type="text" name="language" value="{{ movie.language }}" maxlength="100">
            </div>

            <div class="form-group">
                <label>Country</label>
                <input type="text" name="country" value="{{ movie.country }}" maxlength="100">
            </div>

            <div class="form-group form-full">
                <label>Description / Synopsis</label>
                <textarea name="description">{{ movie.description }}</textarea>
            </div>
        </div>

        <h3 style="margin:1.5rem 0 1.2rem; color:var(--accent); border-bottom:1px solid var(--border); padding-bottom:.6rem;">⭐ Ratings & Status</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Your Rating (0–10)</label>
                <input type="number" name="rating" min="0" max="10" step="0.1" value="{{ movie.rating }}">
            </div>

            <div class="form-group">
                <label>Watch Status</label>
                <select name="watch_status">
                    <option value="Not Watched" {% if movie.watch_status == 'Not Watched' %}selected{% endif %}>Not Watched</option>
                    <option value="Watching"    {% if movie.watch_status == 'Watching'     %}selected{% endif %}>Watching</option>
                    <option value="Watched"     {% if movie.watch_status == 'Watched'      %}selected{% endif %}>Watched</option>
                    <option value="Dropped"     {% if movie.watch_status == 'Dropped'      %}selected{% endif %}>Dropped</option>
                </select>
            </div>
        </div>

        <h3 style="margin:1.5rem 0 1.2rem; color:var(--accent); border-bottom:1px solid var(--border); padding-bottom:.6rem;">💰 Purchase Details</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Price Paid (£)</label>
                <input type="number" name="price" min="0" step="0.01" value="{{ movie.price }}">
            </div>

            <div class="form-group">
                <label>Purchase Date</label>
                <input type="date" name="purchase_date" value="{{ movie.purchase_date }}">
            </div>
        </div>

        <h3 style="margin:1.5rem 0 1rem; color:var(--accent); border-bottom:1px solid var(--border); padding-bottom:.6rem;">🏷️ Tags</h3>
        <div class="checkbox-group">
            <label class="checkbox-label">
                <input type="checkbox" name="is_favourite" {% if movie.is_favourite %}checked{% endif %}> ⭐ Favourite
            </label>
            <label class="checkbox-label">
                <input type="checkbox" name="has_sequel" {% if movie.has_sequel %}checked{% endif %}> 🎬 Has Sequel
            </label>
            <label class="checkbox-label">
                <input type="checkbox" name="is_4k" {% if movie.is_4k %}checked{% endif %}> 📺 4K Version
            </label>
        </div>

        <div style="margin-top:2rem; display:flex; gap:1rem;">
            <button type="submit" class="btn btn-primary" style="padding:.7rem 2rem;">💾 Save Changes</button>
            <a href="movie_details.php?id={{ movie.movie_id }}" class="btn btn-secondary" style="padding:.7rem 2rem;">Cancel</a>
        </div>

    </form>
</div>

{% endblock %}
