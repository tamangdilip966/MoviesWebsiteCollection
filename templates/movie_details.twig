{% extends 'base.twig' %}
{% block title %}{{ movie.title }} – {{ site_name }}{% endblock %}
{% block content %}

<div class="breadcrumb"><a href="index.php">Home</a> › {{ movie.title }}</div>

<div class="page-header">
    <h1>🎬 Movie Details</h1>
    <div style="display:flex; gap:.8rem;">
        <a href="edit_movie.php?id={{ movie.movie_id }}" class="btn btn-edit">✏️ Edit</a>
        <a href="delete_movie.php?id={{ movie.movie_id }}" class="btn btn-danger"
           onclick="return confirm('Are you sure you want to delete this movie?')">🗑️ Delete</a>
        <a href="index.php" class="btn btn-secondary">← Back</a>
    </div>
</div>

<div class="detail-grid">
    {# Sidebar #}
    <div class="detail-sidebar">
        {% if movie.rating %}
        <div style="text-align:center; margin-bottom:1.5rem;">
            <div class="detail-rating-big">{{ movie.rating }}</div>
            <div style="color:var(--gold); font-size:.9rem;">★★★★★ Your Rating / 10</div>
        </div>
        {% endif %}

        <div style="margin-bottom:1.5rem;">
            {% if movie.watch_status == 'Watched' %}
                <span class="badge badge-watched" style="font-size:.9rem; padding:.4rem 1rem;">✓ Watched</span>
            {% elseif movie.watch_status == 'Watching' %}
                <span class="badge badge-watching" style="font-size:.9rem; padding:.4rem 1rem;">▶ Currently Watching</span>
            {% elseif movie.watch_status == 'Dropped' %}
                <span class="badge badge-dropped" style="font-size:.9rem; padding:.4rem 1rem;">✗ Dropped</span>
            {% else %}
                <span class="badge badge-not-watched" style="font-size:.9rem; padding:.4rem 1rem;">○ Not Watched</span>
            {% endif %}
        </div>

        <div class="detail-info-row">
            <span class="label">Genre</span>
            <span>{% if movie.genre %}{{ movie.genre }}{% else %}—{% endif %}</span>
        </div>
        <div class="detail-info-row">
            <span class="label">Release Year</span>
            <span>{% if movie.release_year %}{{ movie.release_year }}{% else %}—{% endif %}</span>
        </div>
        <div class="detail-info-row">
            <span class="label">Duration</span>
            <span>{% if movie.duration_minutes %}{{ movie.duration_minutes }} min ({{ (movie.duration_minutes / 60)|round(1) }}h){% else %}—{% endif %}</span>
        </div>
        <div class="detail-info-row">
            <span class="label">Language</span>
            <span>{% if movie.language %}{{ movie.language }}{% else %}—{% endif %}</span>
        </div>
        <div class="detail-info-row">
            <span class="label">Country</span>
            <span>{% if movie.country %}{{ movie.country }}{% else %}—{% endif %}</span>
        </div>
        {% if movie.price %}
        <div class="detail-info-row">
            <span class="label">Price Paid</span>
            <span>£{{ movie.price }}</span>
        </div>
        {% endif %}
        {% if movie.purchase_date %}
        <div class="detail-info-row">
            <span class="label">Purchased</span>
            <span>{{ movie.purchase_date }}</span>
        </div>
        {% endif %}
        <div class="detail-info-row">
            <span class="label">Added</span>
            <span>{{ movie.created_at|slice(0,10) }}</span>
        </div>

        <div style="margin-top:1.2rem; display:flex; gap:.5rem; flex-wrap:wrap;">
            {% if movie.is_favourite %}<span class="badge badge-fav">⭐ Favourite</span>{% endif %}
            {% if movie.has_sequel %}<span class="tag">🎬 Has Sequel</span>{% endif %}
            {% if movie.is_4k %}<span class="tag">📺 4K</span>{% endif %}
        </div>
    </div>

    {# Main content #}
    <div>
        <h1 style="font-size:2.2rem; margin-bottom:.3rem;">
            {% if movie.is_favourite %}<span style="color:var(--gold);">★</span> {% endif %}
            {{ movie.title }}
        </h1>

        {% if movie.genre %}
        <span class="badge badge-genre" style="margin-bottom:1rem; display:inline-block;">{{ movie.genre }}</span>
        {% endif %}

        {% if movie.director %}
        <div class="card-sm" style="margin-bottom:1rem;">
            <strong style="color:var(--muted); font-size:.85rem;">DIRECTOR</strong>
            <p style="margin-top:.3rem; font-size:1.1rem;">🎬 {{ movie.director }}</p>
        </div>
        {% endif %}

        {% if movie.cast_members %}
        <div class="card-sm" style="margin-bottom:1rem;">
            <strong style="color:var(--muted); font-size:.85rem;">CAST</strong>
            <p style="margin-top:.3rem; font-size:1rem;">🎭 {{ movie.cast_members }}</p>
        </div>
        {% endif %}

        {% if movie.description %}
        <div class="card-sm" style="margin-bottom:1rem;">
            <strong style="color:var(--muted); font-size:.85rem;">SYNOPSIS</strong>
            <p style="margin-top:.5rem; line-height:1.7; font-size:.95rem;">{{ movie.description }}</p>
        </div>
        {% endif %}

        <div style="margin-top:1.5rem; display:flex; gap:1rem; flex-wrap:wrap;">
            <a href="edit_movie.php?id={{ movie.movie_id }}" class="btn btn-edit" style="padding:.6rem 1.5rem;">✏️ Edit This Movie</a>
            <a href="index.php" class="btn btn-secondary" style="padding:.6rem 1.5rem;">← Back to Collection</a>
        </div>
    </div>
</div>

{% endblock %}
