{% extends 'base.twig' %}
{% block title %}Add Movie – {{ site_name }}{% endblock %}
{% block content %}

<div class="breadcrumb"><a href="index.php">Home</a> › Add Movie</div>

<div class="page-header">
    <h1>🎬 Add New Movie</h1>
    <a href="index.php" class="btn btn-secondary">← Back to Collection</a>
</div>

{% if errors %}
<div class="errors">
    <strong>Please fix the following:</strong>
    <ul>{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
</div>
{% endif %}

<div class="card">
    <form method="POST" action="add_movie.php">

        <h3 style="margin-bottom:1.2rem; color:var(--accent); border-bottom:1px solid var(--border); padding-bottom:.6rem;">📋 Basic Information</h3>
        <div class="form-grid">
            <div class="form-group form-full">
                <label>Movie Title <span style="color:var(--accent);">*</span></label>
                <input type="text" name="title" required placeholder="e.g. The Dark Knight" maxlength="255">
            </div>

            <div class="form-group">
                <label>Genre</label>
                <input type="text" name="genre" list="genre-list" placeholder="e.g. Action, Drama, Sci-Fi">
                <datalist id="genre-list">
                    {% for g in existing_genres %}
                    <option value="{{ g.genre }}">
                    {% endfor %}
                </datalist>
            </div>

            <div class="form-group">
                <label>Director</label>
                <input type="text" name="director" placeholder="e.g. Christopher Nolan" maxlength="255">
            </div>

            <div class="form-group form-full">
                <label>Cast Members</label>
                <input type="text" name="cast_members" placeholder="e.g. Christian Bale, Heath Ledger, Aaron Eckhart" maxlength="500">
            </div>

            <div class="form-group">
                <label>Release Year</label>
                <input type="number" name="release_year" min="1888" max="2030" placeholder="e.g. 2008">
            </div>

            <div class="form-group">
                <label>Duration (minutes)</label>
                <input type="number" name="duration_minutes" min="1" max="999" placeholder="e.g. 152">
            </div>

            <div class="form-group">
                <label>Language</label>
                <input type="text" name="language" placeholder="e.g. English, Korean, Japanese" maxlength="100">
            </div>

            <div class="form-group">
                <label>Country</label>
                <input type="text" name="country" placeholder="e.g. USA, UK, South Korea" maxlength="100">
            </div>

            <div class="form-group form-full">
                <label>Description / Synopsis</label>
                <textarea name="description" placeholder="Brief synopsis or personal notes about the movie…"></textarea>
            </div>
        </div>

        <h3 style="margin:1.5rem 0 1.2rem; color:var(--accent); border-bottom:1px solid var(--border); padding-bottom:.6rem;">⭐ Ratings & Status</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Your Rating (0–10)</label>
                <input type="number" name="rating" min="0" max="10" step="0.1" placeholder="e.g. 9.5">
            </div>

            <div class="form-group">
                <label>Watch Status</label>
                <select name="watch_status">
                    <option value="Not Watched">Not Watched</option>
                    <option value="Watching">Watching</option>
                    <option value="Watched">Watched</option>
                    <option value="Dropped">Dropped</option>
                </select>
            </div>
        </div>

        <h3 style="margin:1.5rem 0 1.2rem; color:var(--accent); border-bottom:1px solid var(--border); padding-bottom:.6rem;">💰 Purchase Details</h3>
        <div class="form-grid">
            <div class="form-group">
                <label>Price Paid (£)</label>
                <input type="number" name="price" min="0" step="0.01" placeholder="e.g. 9.99">
            </div>

            <div class="form-group">
                <label>Purchase Date</label>
                <input type="date" name="purchase_date">
            </div>
        </div>

        <h3 style="margin:1.5rem 0 1rem; color:var(--accent); border-bottom:1px solid var(--border); padding-bottom:.6rem;">🏷️ Tags</h3>
        <div class="checkbox-group">
            <label class="checkbox-label">
                <input type="checkbox" name="is_favourite"> ⭐ Favourite
            </label>
            <label class="checkbox-label">
                <input type="checkbox" name="has_sequel"> 🎬 Has Sequel
            </label>
            <label class="checkbox-label">
                <input type="checkbox" name="is_4k"> 📺 4K Version
            </label>
        </div>

        <div style="margin-top:2rem; display:flex; gap:1rem;">
            <button type="submit" class="btn btn-primary" style="padding:.7rem 2rem;">✅ Add Movie</button>
            <a href="index.php" class="btn btn-secondary" style="padding:.7rem 2rem;">Cancel</a>
        </div>

    </form>
</div>

{% endblock %}
